<Window x:Class="Time_in_the_World.AddClockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a clock" Width="560" Height="650" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Find your next clock" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Choose a time zone, then give it a name." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Label Target="{Binding ElementName=SearchBox}" Content="Search city or time zone" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,7"/>
            <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search city or time zone"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <ListBox x:Name="ZoneList" Background="{StaticResource SurfaceBrush}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ZoneList_SelectionChanged" AutomationProperties.Name="Time zones">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoResults" Text="No matching zones. Try another city or region." TextWrapping="Wrap" Margin="16" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <Label Target="{Binding ElementName=NameBox}" Content="Clock name" Foreground="{StaticResource MutedBrush}" Padding="0,0,0,7"/>
            <TextBox x:Name="NameBox" MaxLength="60" TextChanged="NameBox_TextChanged" AutomationProperties.Name="Clock name"/>
        </StackPanel>
        <TextBlock Grid.Row="4" Text="Times follow the selected zone's daylight saving rules." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,18" TextWrapping="Wrap"/>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button x:Name="AddButton" Content="Add clock" Style="{StaticResource PrimaryButton}" IsDefault="True" IsEnabled="False" Click="Add_Click"/>
        </StackPanel>
    </Grid>
</Window>
